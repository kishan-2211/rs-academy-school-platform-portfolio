# Copy to .env for local development. Never commit real secrets.
COMPOSE_PROJECT_NAME=educore
POSTGRES_DB=educore
POSTGRES_USER=educore
POSTGRES_PASSWORD=change-me-locally
# API connection defaults are local only. Production must use a separately
# provisioned, non-owner runtime login: docs/operations/DATABASE_RUNTIME_SECURITY.md.
DATABASE_URL=jdbc:postgresql://localhost:5432/educore
DATABASE_USER=educore
DATABASE_PASSWORD=change-me-locally
REDIS_PASSWORD=change-me-locally
MINIO_ROOT_USER=educore-local
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_BUCKET=educore-private

# Browser-facing URL (local defaults remain unchanged).
# Intended production domain/HTTPS example: .env.production.example and
# docs/operations/PRODUCTION_DOMAIN.md. Do not copy production origins into local development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# API settings
APP_PUBLIC_URL=http://localhost:3000
APP_ALLOWED_ORIGINS=http://localhost:3000
APP_PUBLIC_ORGANISATION_ID=10000000-0000-4000-8000-000000000001
APP_PUBLIC_SCHOOL_ID=10000000-0000-4000-8000-000000000002
APP_COOKIE_SECURE=false
APP_BOOTSTRAP_ENABLED=true
APP_BOOTSTRAP_ADMIN_EMAIL=admin@educore.local
APP_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
APP_TOTP_ISSUER=EduCore
APP_GUARDIAN_INVITATION_TTL=72h
# Database-only expiry housekeeping; does not enable invitation sending or grant access.
APP_GUARDIAN_INVITATION_EXPIRY_ENABLED=true
APP_GUARDIAN_INVITATION_EXPIRY_POLL_DELAY_MS=60000
APP_GUARDIAN_INVITATION_EXPIRY_INITIAL_DELAY_MS=30000
# Database-only calendar/PTM publication; separate push sending stays disabled.
APP_CALENDAR_NOTIFICATIONS_ENABLED=true
APP_CALENDAR_NOTIFICATIONS_POLL_DELAY_MS=60000
APP_CALENDAR_NOTIFICATIONS_INITIAL_DELAY_MS=30000
APP_PTM_REMINDERS_ENABLED=true
APP_PTM_REMINDERS_POLL_DELAY_MS=60000
APP_PTM_REMINDERS_INITIAL_DELAY_MS=30000

# Development adapters
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@educore.local
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
# Provision a separate bucket-scoped identity; never reuse MINIO_ROOT_* here.
# See docs/operations/PRIVATE_FILES_RUNBOOK.md. No credentials are supplied.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_CONNECT_TIMEOUT=3s
S3_READ_TIMEOUT=30s
S3_PATH_STYLE_ACCESS=true
S3_AUTO_CREATE_BUCKET=false
APP_FILES_MAX_SIZE_BYTES=10485760
APP_FILES_MAX_REQUEST_SIZE=11MB
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT=3s
CLAMAV_READ_TIMEOUT=30s

# Web Push remains off until provider configuration and real-device rehearsal are approved.
# Never commit real VAPID private keys or replace an existing deployment's key pair casually.
APP_PUSH_REGISTRATION_ENABLED=false
APP_PUSH_APPLICATION_SERVER_KEY=
APP_PUSH_DELIVERY_ENABLED=false
APP_PUSH_WORKER_ENABLED=false
# Database-only family request inbox publication; does not enable provider sending.
APP_LEARNING_NOTIFICATIONS_ENABLED=true
APP_LEARNING_NOTIFICATIONS_POLL_DELAY_MS=60000
APP_LEARNING_NOTIFICATIONS_INITIAL_DELAY_MS=30000
APP_PARENT_REQUEST_NOTIFICATIONS_ENABLED=true
APP_PARENT_REQUEST_NOTIFICATIONS_POLL_DELAY_MS=60000
APP_PARENT_REQUEST_NOTIFICATIONS_INITIAL_DELAY_MS=30000
APP_STUDENT_LEAVE_NOTIFICATIONS_ENABLED=true
APP_STUDENT_LEAVE_NOTIFICATIONS_POLL_DELAY_MS=60000
APP_STUDENT_LEAVE_NOTIFICATIONS_INITIAL_DELAY_MS=30000
APP_PUSH_POLL_DELAY_MS=15000
APP_PUSH_INITIAL_DELAY_MS=30000
APP_PUSH_DELIVERY_PRIVATE_KEY=
APP_PUSH_DELIVERY_SUBJECT=
APP_PUSH_DELIVERY_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com
APP_PUSH_DELIVERY_REQUEST_TIMEOUT_SECONDS=10
