# Non-secret intended-production URL fragment, not a runnable deployment recipe.
# Owner purchased rsacademyschool.in; registrar hold clearance, hosting, DNS,
# Configure and verify HTTPS before using these addresses. See docs/operations/PRODUCTION_DOMAIN.md.
# Do not load this fragment into the running local development application.
# NEXT_PUBLIC_* must be supplied when building the eventual approved web image.

NEXT_PUBLIC_APP_URL=https://rsacademyschool.in
# Browser API base: a future approved HTTPS edge must forward /api/ to the API
# while preserving the path. Next.js currently does not provide that proxy.
NEXT_PUBLIC_API_URL=https://rsacademyschool.in
APP_PUBLIC_URL=https://rsacademyschool.in
APP_ALLOWED_ORIGINS=https://rsacademyschool.in
APP_COOKIE_SECURE=true
# Empty retains host-only cookies. Do not broaden to .rsacademyschool.in.
APP_COOKIE_DOMAIN=
APP_BOOTSTRAP_ENABLED=false

# Domain purchase does not activate a gateway, live payments or phone delivery.
APP_FINANCE_GATEWAY_CREATION_ENABLED=false
APP_FINANCE_GATEWAY_WORKER_ENABLED=false
APP_FINANCE_GATEWAY_LIVE_ENABLED=false
APP_FINANCE_GATEWAY_REFUNDS_ENABLED=false
APP_FINANCE_GATEWAY_TEST_ALLOW_LOOPBACK=false
APP_PUSH_REGISTRATION_ENABLED=false
APP_PUSH_DELIVERY_ENABLED=false
APP_PUSH_WORKER_ENABLED=false

# Supply confirmed school UUIDs, the non-owner database connection, encryption
# material, private storage/scanner configuration and other required settings
# separately through approved operator secret/configuration custody, never Git.
# No server, address, credential, merchant route or storage provider is selected here.
