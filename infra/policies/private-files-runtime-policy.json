{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrivateBucketReadiness",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::__BUCKET_NAME__"]
    },
    {
      "Sid": "PrivateFileBytesAndFailedUploadCleanup",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::__BUCKET_NAME__/*"]
    }
  ]
}
